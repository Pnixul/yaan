# Copy to .env.local and fill these from the EXISTING YAAN Supabase project.
# Use a publishable key (sb_publishable_...), never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted app origin used for email confirmation. Use your HTTPS origin in production.
SITE_URL=http://localhost:3000
